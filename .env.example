# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Supabase — use the DEV project locally and in Railway "development".
# Keys: `supabase projects api-keys --reveal` (or Dashboard → Project Settings → API Keys).
SUPABASE_URL=
# Publishable key (sb_publishable_...). Sent to the browser; RLS protects the data.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-side only. Never expose to the browser or commit.
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Connect → Connection pooler). Not needed yet.
DATABASE_URL=

# Password for all demo users created by backend/scripts/seed_dev.py (dev only).
DEMO_USER_PASSWORD=

# LLM provider — undecided (docs/OPEN_DECISIONS.md #16). Added in Phase 4.
